# Copiá este archivo como .env y completá los valores. El .env nunca se sube al repo.

# Base de datos (docker compose la crea con estos datos)
DB_USER=farmacia
DB_PASSWORD=cambiame
# Solo hace falta si levantás la API fuera de docker compose:
# DB_URL=jdbc:postgresql://localhost:5432/farmacia

# Clave para firmar los JWT: mínimo 32 bytes. Para generarla:
#   bash o Git Bash:  openssl rand -base64 48
#   PowerShell:       $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=

# Contraseña del usuario admin. Solo se usa si todavía no existe ningún ADMIN (mínimo 8 caracteres).
ADMIN_PASSWORD=

# Contraseña de los usuarios farmaceutico y consulta del perfil demo.
DEMO_PASSWORD=demo1234

# Orígenes permitidos por CORS, separados por coma. Vacío si el front va detrás del mismo proxy.
CORS_ORIGENES=

# dev, demo o prod (nunca demo y prod juntos)
SPRING_PROFILES_ACTIVE=demo
