### Farmacia Hospitalaria — pedidos de ejemplo
# Funciona con la extensión REST Client de VS Code y con el cliente HTTP de IntelliJ.
# Primero ejecutá el login: el token queda guardado en {{token}}.

@baseUrl = http://localhost:8080
@hoy = 2026-11-09

### Login
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{"username": "admin", "password": "cambiame-admin"}

###
@token = {{login.response.body.token}}

### Mi sesión y permisos
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{token}}

### Cambiar mi contraseña
PATCH {{baseUrl}}/api/auth/me/password
Authorization: Bearer {{token}}
Content-Type: application/json

{"passwordActual": "cambiame-admin", "passwordNueva": "otra-clave-segura"}

### Usuarios
GET {{baseUrl}}/api/usuarios?activo=true&sort=username,asc
Authorization: Bearer {{token}}

### Crear usuario
POST {{baseUrl}}/api/usuarios
Authorization: Bearer {{token}}
Content-Type: application/json

{"username": "lperez", "nombreCompleto": "Laura Pérez", "rol": "FARMACEUTICO", "password": "clave-segura-1"}

### Editar usuario
PUT {{baseUrl}}/api/usuarios/2
Authorization: Bearer {{token}}
Content-Type: application/json

{"nombreCompleto": "Laura Pérez", "rol": "CONSULTA"}

### Desactivar usuario
PATCH {{baseUrl}}/api/usuarios/2/estado
Authorization: Bearer {{token}}
Content-Type: application/json

{"activo": false}

### Restablecer contraseña
PATCH {{baseUrl}}/api/usuarios/2/password
Authorization: Bearer {{token}}
Content-Type: application/json

{"passwordNueva": "clave-nueva-1"}

### Proveedores
GET {{baseUrl}}/api/proveedores?q=norte
Authorization: Bearer {{token}}

### Crear proveedor
POST {{baseUrl}}/api/proveedores
Authorization: Bearer {{token}}
Content-Type: application/json

{"razonSocial": "Droguería Ejemplo S.A.", "cuit": "30-71234567-1", "telefono": "0381 400-0000", "email": "compras@ejemplo.test"}

### Dar de baja un proveedor
PATCH {{baseUrl}}/api/proveedores/1/estado
Authorization: Bearer {{token}}
Content-Type: application/json

{"activo": false}

### Áreas
GET {{baseUrl}}/api/areas?activo=true
Authorization: Bearer {{token}}

### Crear área
POST {{baseUrl}}/api/areas
Authorization: Bearer {{token}}
Content-Type: application/json

{"nombre": "Hemodiálisis"}

### Medicamentos con stock bajo
GET {{baseUrl}}/api/medicamentos?estado=STOCK_BAJO&sort=stockTotal,asc
Authorization: Bearer {{token}}

### Detalle de un medicamento (lotes en orden FEFO)
GET {{baseUrl}}/api/medicamentos/1
Authorization: Bearer {{token}}

### Crear medicamento
POST {{baseUrl}}/api/medicamentos
Authorization: Bearer {{token}}
Content-Type: application/json

{"codigo": "CEFA-1G", "nombre": "Cefalexina", "presentacion": "cápsulas 500 mg", "stockMinimo": 100}

### Ingresar un lote
POST {{baseUrl}}/api/medicamentos/1/lotes
Authorization: Bearer {{token}}
Content-Type: application/json

{"proveedorId": 1, "numeroLote": "A-2027-001", "fechaVencimiento": "2027-06-30", "cantidad": 200}

### Lotes vencidos o por vencer
GET {{baseUrl}}/api/lotes?estado=VENCIDO&estado=POR_VENCER&sort=fechaVencimiento,asc
Authorization: Bearer {{token}}

### Baja por vencimiento
POST {{baseUrl}}/api/lotes/1/baja
Authorization: Bearer {{token}}
Content-Type: application/json

{"motivo": "Vencido, enviado a disposición final"}

### Ajuste de inventario
POST {{baseUrl}}/api/lotes/1/ajuste
Authorization: Bearer {{token}}
Content-Type: application/json

{"cantidadNueva": 95, "motivo": "Rotura de 5 ampollas"}

### Movimientos de un lote
GET {{baseUrl}}/api/movimientos?loteId=1
Authorization: Bearer {{token}}

### Transferir a un área (FEFO)
POST {{baseUrl}}/api/transferencias
Authorization: Bearer {{token}}
Content-Type: application/json

{"areaId": 1, "observaciones": "Pedido de guardia", "items": [{"medicamentoId": 1, "cantidad": 20}, {"medicamentoId": 2, "cantidad": 5}]}

### Transferencias del mes
GET {{baseUrl}}/api/transferencias?desde=2026-11-01&hasta={{hoy}}
Authorization: Bearer {{token}}

### Comprobante
GET {{baseUrl}}/api/transferencias/1
Authorization: Bearer {{token}}

### Exportar a Excel (CSV)
GET {{baseUrl}}/api/transferencias/exportar?desde=2026-11-01&hasta={{hoy}}
Authorization: Bearer {{token}}

### Alertas
GET {{baseUrl}}/api/alertas
Authorization: Bearer {{token}}

### Resumen para el tablero
GET {{baseUrl}}/api/resumen
Authorization: Bearer {{token}}

### Salud (público)
GET {{baseUrl}}/actuator/health
